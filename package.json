{
  "name": "bismyth-lead-tui",
  "version": "0.5.0",
  "description": "Oracle Leads: terminal outreach and relationship workspace with scoped WhatsApp and persistent memory",
  "license": "(MIT AND Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aansh-afk/bismyth-lead-tui.git"
  },
  "homepage": "https://github.com/aansh-afk/bismyth-lead-tui#readme",
  "bin": {
    "bismyth-leads": "leads/launch.sh",
    "oracle-leads": "leads/launch.sh",
    "oracle": "oracle.py"
  },
  "files": [
    "leads/server",
    "leads/terminal.py",
    "leads/launch.sh",
    "leads/docs",
    "oracle.py",
    "engine.py",
    "instructions.md",
    "catalog.json",
    "UPSTREAM-NOTICE",
    "ORACLE-LICENSE",
    "install.sh",
    "leads/bin",
    "leads/tui/Cargo.toml",
    "leads/tui/Cargo.lock",
    "leads/tui/src",
    "leads/build_tui.py"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "python3 leads/terminal.py",
    "test": "node --test leads/tests/*.test.mjs",
    "test:terminal": "python3 leads/tests/terminal_smoke.py",
    "test:installed": "python3 leads/tests/installed_smoke.py",
    "build:tui": "python3 leads/build_tui.py",
    "test:native": "python3 leads/tests/native_smoke.py",
    "test:pairing": "python3 leads/tests/pairing_smoke.py",
    "test:directory": "python3 leads/tests/directory_smoke.py",
    "setup:laya": "node leads/server/laya-setup.mjs"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "@receptron/laya": "0.2.0",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "pino": "9.14.0",
    "qrcode": "1.5.4"
  }
}
