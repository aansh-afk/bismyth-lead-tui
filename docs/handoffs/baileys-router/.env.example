# Deployment placeholders; no actual credentials included.
PORT=3001
WHATSAPP_ROUTER_API_KEY=replace-with-a-strong-private-secret
DATA_DIR=/data
ALLOWED_ORIGINS=http://localhost

# TUI v0.1.15 client settings; deploy and pair the router before use.
BISMYTH_WHATSAPP_ROUTER_URL=http://localhost:3001
