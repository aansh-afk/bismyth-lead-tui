{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bismyth router event envelope",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "cursor": {
      "type": "string"
    },
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "enum": [
        "connection",
        "qr",
        "message",
        "message:status"
      ]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object"
    }
  },
  "required": [
    "eventId",
    "cursor",
    "userId",
    "type",
    "occurredAt",
    "data"
  ],
  "additionalProperties": false,
  "$defs": {
    "Contact": {
      "type": "object",
      "properties": {
        "displayName": {
          "type": [
            "string",
            "null"
          ]
        },
        "phones": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\+[1-9][0-9]{7,14}$"
          }
        }
      },
      "required": [
        "displayName",
        "phones"
      ],
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "requestId",
        "error"
      ],
      "additionalProperties": false
    },
    "Health": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "apiVersion": {
          "const": "1"
        },
        "ready": {
          "type": "boolean"
        }
      },
      "required": [
        "ok",
        "apiVersion",
        "ready"
      ],
      "additionalProperties": false
    },
    "Session": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "status": {
          "enum": [
            "pending",
            "connecting",
            "qr_ready",
            "connected",
            "disconnected",
            "logged_out"
          ]
        },
        "phone": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\+[1-9][0-9]{7,14}$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "name",
        "status",
        "phone",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    "CreateSession": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "clientRequestId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "name",
        "clientRequestId"
      ],
      "additionalProperties": false
    },
    "Pairing": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "format": "uuid"
        },
        "qrRaw": {
          "type": "string",
          "minLength": 1
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "qrRaw",
        "expiresAt"
      ],
      "additionalProperties": false
    },
    "Send": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "format": "uuid"
        },
        "to": {
          "type": "string",
          "pattern": "^\\+[1-9][0-9]{7,14}$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "clientRequestId": {
          "type": "string",
          "format": "uuid"
        },
        "dryRun": {
          "type": "boolean",
          "default": true
        }
      },
      "required": [
        "userId",
        "to",
        "message",
        "clientRequestId",
        "dryRun"
      ],
      "additionalProperties": false
    },
    "SendResult": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "format": "uuid"
        },
        "clientRequestId": {
          "type": "string",
          "format": "uuid"
        },
        "operationId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "messageId": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "preview",
            "queued",
            "sending",
            "sent",
            "delivered",
            "read",
            "failed",
            "uncertain"
          ]
        }
      },
      "required": [
        "userId",
        "clientRequestId",
        "operationId",
        "messageId",
        "status"
      ],
      "additionalProperties": false
    },
    "Operation": {
      "type": "object",
      "properties": {
        "operationId": {
          "type": "string",
          "format": "uuid"
        },
        "userId": {
          "type": "string",
          "format": "uuid"
        },
        "clientRequestId": {
          "type": "string",
          "format": "uuid"
        },
        "messageId": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "queued",
            "sending",
            "sent",
            "delivered",
            "read",
            "failed",
            "uncertain"
          ]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "errorCode": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "operationId",
        "userId",
        "clientRequestId",
        "messageId",
        "status",
        "updatedAt",
        "errorCode"
      ],
      "additionalProperties": false
    },
    "Chat": {
      "type": "object",
      "properties": {
        "chatId": {
          "type": "string"
        },
        "remoteJid": {
          "type": "string"
        },
        "displayName": {
          "type": [
            "string",
            "null"
          ]
        },
        "phone": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\+[1-9][0-9]{7,14}$"
        },
        "isGroup": {
          "type": "boolean"
        },
        "lastMessageAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "chatId",
        "remoteJid",
        "displayName",
        "phone",
        "isGroup",
        "lastMessageAt"
      ],
      "additionalProperties": false
    },
    "Message": {
      "type": "object",
      "properties": {
        "messageId": {
          "type": "string"
        },
        "chatId": {
          "type": "string"
        },
        "remoteJid": {
          "type": "string"
        },
        "fromMe": {
          "type": "boolean"
        },
        "isHistorical": {
          "type": "boolean"
        },
        "senderPhone": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\+[1-9][0-9]{7,14}$"
        },
        "displayName": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "enum": [
            "text",
            "contact",
            "contacts",
            "image",
            "audio",
            "other"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "contacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Contact"
          }
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "enum": [
            "pending",
            "sent",
            "delivered",
            "read",
            "failed",
            "unknown"
          ]
        }
      },
      "required": [
        "messageId",
        "chatId",
        "remoteJid",
        "fromMe",
        "isHistorical",
        "senderPhone",
        "displayName",
        "type",
        "text",
        "contacts",
        "timestamp",
        "status"
      ],
      "additionalProperties": false
    },
    "NumberCheck": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "format": "uuid"
        },
        "phone": {
          "type": "string",
          "pattern": "^\\+[1-9][0-9]{7,14}$"
        },
        "onWhatsApp": {
          "type": "boolean"
        },
        "jid": {
          "type": [
            "string",
            "null"
          ]
        },
        "checkedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "phone",
        "onWhatsApp",
        "jid",
        "checkedAt"
      ],
      "additionalProperties": false
    },
    "Event": {
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "cursor": {
          "type": "string"
        },
        "userId": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "enum": [
            "connection",
            "qr",
            "message",
            "message:status"
          ]
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "data": {
          "type": "object"
        }
      },
      "required": [
        "eventId",
        "cursor",
        "userId",
        "type",
        "occurredAt",
        "data"
      ],
      "additionalProperties": false
    },
    "Sessions": {
      "type": "object",
      "properties": {
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Session"
          }
        }
      },
      "required": [
        "sessions"
      ],
      "additionalProperties": false
    },
    "Chats": {
      "type": "object",
      "properties": {
        "chats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Chat"
          }
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "chats",
        "nextCursor"
      ],
      "additionalProperties": false
    },
    "Messages": {
      "type": "object",
      "properties": {
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Message"
          }
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "messages",
        "nextCursor"
      ],
      "additionalProperties": false
    },
    "Events": {
      "type": "object",
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Event"
          }
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "events",
        "nextCursor"
      ],
      "additionalProperties": false
    },
    "Receipt": {
      "type": "object",
      "properties": {
        "clientRequestId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "operationId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "messageId": {
          "type": "string"
        },
        "chatId": {
          "type": "string"
        },
        "status": {
          "enum": [
            "sent",
            "delivered",
            "read",
            "failed",
            "uncertain"
          ]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "clientRequestId",
        "operationId",
        "messageId",
        "chatId",
        "status",
        "timestamp"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "connection"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/Session"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "qr"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/Pairing"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "message"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/Message"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "message:status"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/Receipt"
          }
        }
      }
    }
  ]
}
