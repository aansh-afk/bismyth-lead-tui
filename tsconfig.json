{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext", "moduleResolution": "NodeNext", "outDir": "dist",
    "rootDir": "src", "strict": true, "skipLibCheck": true, "types": ["node"],
    "noUnusedLocals": true, "noUnusedParameters": true,
    "verbatimModuleSyntax": true, "sourceMap": true
  },
  "include": ["src/**/*.ts"]
}
